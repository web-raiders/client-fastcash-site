---
import Layout from '@components/layout.astro';
import { ProductView, Car4Cash } from '@assets/images';
import { Common } from '@components/index';
import { Data } from "@utils/index";
import { PRODUCTS_PAGE_DESCRIPTION } from '@utils/constants'
import { IoCheckmarkCircle } from "react-icons/io5";

const APPLY_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSe2nvsxuPIdObeks1S6Fa1Tr5IJWZ4n4hqrSWM6GYyDH13Gdg/viewform?usp=preview';
const CAR4CASH_FORM_URL = 'https://forms.gle/maHDrxJhFax6p7Fy8';
const AGENT_NETWORK_FORM_URL = 'https://forms.gle/HZMz8uvB5UhyWLiE9';
---

<Layout title='Products' description={PRODUCTS_PAGE_DESCRIPTION}>
    <!-- Hero Section -->
    <Common.Hero backgroundImage={ProductView} header='Products' caption='Borrow with confidence, repay with ease.' />

    <!-- Flagship: Car4Cash -->
    <section class="w-full bg-[#fff9f5] pt-16 md:pt-24 pb-20 md:pb-28">
        <Common.Container flex="flex-col">
            <div class="w-full flex flex-col gap-y-14 lg:gap-y-0 lg:flex-row lg:gap-x-16 lg:items-center">
                <!-- Left Content -->
                <div class="w-full lg:w-1/2" data-aos='fade-right' data-aos-offset='100'>
                    <span class="inline-block bg-[#F5E9E1] text-red-900 text-[12px] md:text-[13px] font-bold tracking-wide px-4 py-2 rounded-full">Flagship Product &middot; car4cash</span>
                    <h2 class="text-[28px] leading-[32px] md:text-[42px] md:leading-[46px] text-red-900 font-bold mt-6">Need quick cash from your vehicle?</h2>
                    <p class="text-[15px] md:text-base text-gray-600 mt-5 text-justify">
                        Access up to <span class="font-bold text-red-900">&#8358;50 Million</span> using your vehicle through fastcash car4cash. Fast approval, a simple process, and transparent documentation.
                    </p>
                    <!-- Trust chips -->
                    <div class="flex flex-wrap gap-3 mt-7">
                        {
                            Data.car4cash.trustPoints.map((point: string) => (
                                <span class="flex items-center gap-2 bg-white shadow-sm rounded-full px-4 py-2 text-[13px] md:text-sm text-red-900 font-semibold">
                                    <IoCheckmarkCircle color="#F56B1E" size={'18px'} /> {point}
                                </span>
                            ))
                        }
                    </div>
                    <!-- CTAs -->
                    <div class="flex flex-col gap-4 mt-9 sm:flex-row">
                        <Common.Button path={CAR4CASH_FORM_URL} text="Get started" className="text-center py-3 px-8 font-bold text-white bg-[#F56B1E] rounded-full baseline hover:text-[#F56B1E] hover:bg-[#F5E9E1]" />
                        <Common.Button path="/contact" text="Speak to an advisor" className="text-center py-3 px-8 font-bold text-red-900 border border-red-900 rounded-full baseline hover:text-white hover:bg-red-900" />
                    </div>
                </div>
                <!-- Right Image -->
                <div class="w-full lg:w-1/2" data-aos='fade-up' data-aos-offset='100'>
                    <div class="relative">
                        <img src={Car4Cash} alt="car4cash vehicle owner" class="w-full h-[300px] md:h-[460px] object-cover rounded-2xl shadow-xl" />
                        <div class="absolute -bottom-6 left-5 right-5 md:left-8 md:right-auto md:max-w-[330px] bg-red-900 rounded-xl px-6 py-5 shadow-2xl" data-aos='zoom-in' data-aos-offset='100' data-aos-delay='150'>
                            <h6 class="text-[#F56B1E] text-[14px] md:text-[16px] font-semibold">Your asset. Your advantage.</h6>
                            <p class="text-white text-[12px] md:text-[13px] pt-1">Unlock liquidity from your vehicle through a structured, transparent process.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- How it works -->
            <div class="mt-28 md:mt-32">
                <div class="text-center" data-aos='fade-up' data-aos-offset='100'>
                    <h6 class="text-[13px] md:text-base uppercase text-[#F56B1E] font-bold">Simple steps</h6>
                    <h3 class="text-[24px] md:text-[34px] text-red-900 font-bold mt-2">How car4cash works</h3>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10 md:mt-14" data-aos='fade-up' data-aos-offset='100'>
                    {
                        Data.car4cash.steps.map((step: any, i: number) => (
                            <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl p-7 h-full">
                                <div class="w-[48px] h-[48px] rounded-full bg-[#F5E9E1] text-red-900 font-bold flex justify-center items-center text-[18px]">{i + 1}</div>
                                <h4 class="text-[18px] font-bold text-red-900 mt-5">{step.title}</h4>
                                <p class="text-[14px] text-gray-600 mt-2 text-justify">{step.description}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </Common.Container>
    </section>

    <!-- Agent Network -->
    <section class="w-full bg-red-900 py-16 md:py-24">
        <Common.Container flex="flex-col">
            <div class="w-full flex flex-col gap-y-10 lg:gap-y-0 lg:flex-row lg:gap-x-16">
                <!-- Left Content -->
                <div class="w-full lg:w-2/5" data-aos='fade-right' data-aos-offset='100'>
                    <span class="inline-block bg-[#F5E9E1] text-red-900 text-[12px] md:text-[13px] font-bold tracking-wide px-4 py-2 rounded-full">Agent Network</span>
                    <h2 class="text-[28px] leading-[32px] md:text-[42px] md:leading-[46px] text-white font-bold mt-6">Earn by referring car4cash</h2>
                    <p class="text-[15px] md:text-base text-[#F5E9E1] mt-5 text-justify">
                        Join the car4cash agent network and earn a percentage on every referral. Introduce vehicle owners
                        who need quick cash, and get paid when their loan is approved and disbursed.
                    </p>
                    <div class="mt-9">
                        <Common.Button path={AGENT_NETWORK_FORM_URL} text="Apply to become an agent" className="inline-block text-center py-3 px-8 font-bold text-white bg-[#F56B1E] rounded-full baseline hover:text-[#F56B1E] hover:bg-[#F5E9E1]" />
                    </div>
                </div>
                <!-- Right Content -->
                <div class="w-full lg:w-3/5" data-aos='fade-up' data-aos-offset='100'>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        {
                            Data.agentNetwork.benefits.map((benefit: any) => (
                                <div class="bg-white/10 rounded-2xl p-6 h-full">
                                    <div class="flex items-start gap-3">
                                        <IoCheckmarkCircle color="#F56B1E" size={'22px'} />
                                        <div>
                                            <h4 class="text-[16px] md:text-[17px] font-bold text-white">{benefit.title}</h4>
                                            <p class="text-[13px] md:text-[14px] text-[#F5E9E1] mt-2 text-justify">{benefit.description}</p>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>

            <!-- How to join -->
            <div class="mt-20 md:mt-24">
                <div class="text-center" data-aos='fade-up' data-aos-offset='100'>
                    <h6 class="text-[13px] md:text-base uppercase text-[#F56B1E] font-bold">Getting started</h6>
                    <h3 class="text-[24px] md:text-[34px] text-white font-bold mt-2">How to join the network</h3>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-10 md:mt-14" data-aos='fade-up' data-aos-offset='100'>
                    {
                        Data.agentNetwork.steps.map((step: any, i: number) => (
                            <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl p-7 h-full">
                                <div class="w-[48px] h-[48px] rounded-full bg-[#F5E9E1] text-red-900 font-bold flex justify-center items-center text-[18px]">{i + 1}</div>
                                <h4 class="text-[18px] font-bold text-red-900 mt-5">{step.title}</h4>
                                <p class="text-[14px] text-gray-600 mt-2 text-justify">{step.description}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </Common.Container>
    </section>

    <!-- Projects Section -->
    <section class="w-full pt-10 md:pt-32">
        <Common.Container>
            <div class="flex pt-10 flex-col gap-y-10 md:flex-row md:pt-0">
                <Common.Project qualifications={Data.qualifications} page='projects' />
            </div>
        </Common.Container>
    </section>

    <!-- Featured Section -->
    <section class="w-full min-h-screen py-10 pb-32">
        <Common.Container>
            <div class="w-full flex flex-wrap gap-6 mt-24" data-aos='fade-up' data-aos-offset='10'>
                {
                    Data.products.map((item: any) => (
                    <div class="relative overflow-hidden w-full md:w-[350px] lg:w-[310px] xl:w-[380px] h-[500px] bg-cover bg-no-repeat bg-center rounded-xl" style={{ backgroundImage: `linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.6)), url(${item.image})`}}>
                        <div class="cursor-pointer flex-col px-8 mt-[120px] transition ease-in-out delay-150 duration-300 hover:-translate-y-24">
                            <div class={`w-[max-content] backdrop-opacity-10 backdrop-invert bg-white/30 p-5 rounded-full`}>
                                <item.icon size={'30px'} color="#f5e8e1" />
                            </div>
                            <h6 class="text-white font-bold text-[18px] pt-5">{item.name}</h6>
                            <article class="text-white font-semibold pt-3">
                                <p class="text-base text-justify">{item.description}</p>
                            </article>
                        </div>
                        <div class="absolute bottom-0 left-0 mb-10 ml-10">
                            <Common.Button path={item.applyUrl ?? APPLY_URL} text="Apply" className="py-2 px-4 text-[16px] mt-6 text-white bg-[#F56B1E] rounded-full baseline hover:text-[#F56B1E] hover:bg-[#F5E9E1]" />
                        </div>
                    </div>
                    ))
                }
            </div>
        </Common.Container>
    </section>

    <!-- Live Green Section -->
	<Common.Spread />
</Layout>